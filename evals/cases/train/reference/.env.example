# Optional
RUST_LOG="info,omnia_wasi_messaging=debug,omnia_wasi_http=debug,train=debug"

# Deployment environment (prefixes messaging topics, e.g. dev-realtime-train.v1)
ENV="dev"

# Upstream transit APIs
BLOCK_MGT_URL="<block management API base URL>"
CC_STATIC_URL="<CC static GTFS API base URL>"

# Identity used to acquire access tokens for the upstream APIs
AZURE_IDENTITY="<identity name>"
IDENTITY_CLIENT_ID="<client_id>"
IDENTITY_CLIENT_SECRET="<client_secret>"
IDENTITY_TOKEN_URL="<token endpoint>"
