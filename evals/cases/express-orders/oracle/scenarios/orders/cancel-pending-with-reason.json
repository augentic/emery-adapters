{
  "seed": {
    "http": [
      {
        "method": "GET",
        "path": "/rates",
        "query": {
          "zone": "auckland-central-otahuhu",
          "weight": 600
        }
      }
    ]
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/customers",
        "body": {
          "email": "ada@example.nz",
          "name": "Ada Lovelace"
        }
      },
      "capture": {
        "customer": "id"
      },
      "expect": {
        "status": 201
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/orders",
        "body": {
          "customerId": "{customer}",
          "lines": [
            {
              "sku": "WID-001",
              "quantity": 2
            }
          ],
          "shipTo": {
            "line1": "1 Queen Street",
            "suburb": "Auckland Central",
            "city": "Auckland",
            "postcode": "1010"
          }
        }
      },
      "capture": {
        "order": "id"
      },
      "expect": {
        "status": 201
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/orders/{order}/cancel",
        "body": {
          "reason": "customer changed their mind"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "state": "cancelled",
          "transitions": [
            {
              "state": "pending",
              "at": "{timestamp}"
            },
            {
              "state": "cancelled",
              "at": "{timestamp}",
              "note": "customer changed their mind"
            }
          ]
        }
      }
    }
  ]
}
