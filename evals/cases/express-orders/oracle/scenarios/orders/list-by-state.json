          }
        }
      },
      "capture": {
        "first": "id"
      },
      "expect": {
        "status": 201
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/orders",
        "body": {
          "customerId": "{customer}",
          "lines": [
            {
              "sku": "WID-001",
              "quantity": 2
            }
          ],
          "shipTo": {
            "line1": "1 Queen Street",
            "suburb": "Auckland Central",
            "city": "Auckland",
            "postcode": "1010"
          }
        }
      },
      "capture": {
