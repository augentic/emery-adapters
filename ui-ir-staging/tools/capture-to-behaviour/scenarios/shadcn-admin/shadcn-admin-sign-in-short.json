{
  "version": 1,
  "id": "shadcn-admin-sign-in-short",
  "screen": "sign-in",
  "serve": {
    "dir": "${SITES}/shadcn-admin/dist",
    "spa_fallback": true
  },
  "network": {
    "stubs": []
  },
  "start_path": "/sign-in",
  "actions": [
    {
      "step_id": "fill-email",
      "action": "fill",
      "locator": {
        "kind": "css",
        "value": "input[name=email]"
      },
      "value": "user@example.com"
    },
    {
      "step_id": "fill-password",
      "action": "fill",
      "locator": {
        "kind": "css",
        "value": "input[name=password]"
      },
      "value": "abc"
    },
    {
      "step_id": "submit",
      "action": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Sign in"
      }
    }
  ]
}
