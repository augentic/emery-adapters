{
  "version": 1,
  "id": "fastapi-login-guard",
  "screen": "login",
  "serve": {
    "dir": "${EXPERIMENT}/fastapi-html-capture/fixtures/frontend/dist",
    "spa_fallback": true
  },
  "environment": {
    "viewport": {
      "width": 1280,
      "height": 800
    }
  },
  "network": {
    "stubs": [
      {
        "method": "GET",
        "origin": "http://127.0.0.1:8000",
        "path": "/api/v1/users/me",
        "status": 200,
        "body": {
          "id": "00000000-0000-0000-0000-000000000001",
          "email": "user@example.com",
          "is_active": true,
          "is_superuser": false,
          "full_name": "Stub User"
        }
      }
    ],
    "block_prefixes": [
      "/api/"
    ]
  },
  "start_path": "/login",
  "actions": [],
  "storage": {
    "local_storage": {
      "access_token": "stub-token"
    }
  }
}
