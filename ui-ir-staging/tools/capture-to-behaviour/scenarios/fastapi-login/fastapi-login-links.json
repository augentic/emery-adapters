{
  "version": 1,
  "id": "fastapi-login-links",
  "screen": "login",
  "serve": {
    "dir": "${EXPERIMENT}/fastapi-html-capture/fixtures/frontend/dist",
    "spa_fallback": true
  },
  "environment": {
    "viewport": {
      "width": 1280,
      "height": 800
    }
  },
  "network": {
    "stubs": [],
    "block_prefixes": [
      "/api/"
    ]
  },
  "start_path": "/login",
  "actions": [
    {
      "step_id": "sign-up",
      "action": "click",
      "locator": {
        "kind": "role",
        "role": "link",
        "name": "Sign up"
      }
    },
    {
      "step_id": "back",
      "action": "goto",
      "value": "/login"
    },
    {
      "step_id": "forgot-password",
      "action": "click",
      "locator": {
        "kind": "role",
        "role": "link",
        "name": "Forgot your password?"
      }
    }
  ]
}
