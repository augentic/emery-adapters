{
  "version": 1,
  "id": "fastapi-login-failure",
  "screen": "login",
  "serve": {
    "dir": "${EXPERIMENT}/fastapi-html-capture/fixtures/frontend/dist",
    "spa_fallback": true
  },
  "environment": {
    "viewport": {
      "width": 1280,
      "height": 800
    }
  },
  "network": {
    "stubs": [
      {
        "method": "POST",
        "path": "/api/v1/login/access-token",
        "status": 400,
        "body": {
          "detail": "Incorrect email or password"
        },
        "origin": "http://127.0.0.1:8000"
      }
    ],
    "block_prefixes": [
      "/api/"
    ]
  },
  "start_path": "/login",
  "actions": [
    {
      "step_id": "fill-email",
      "action": "fill",
      "locator": {
        "kind": "test_id",
        "value": "email-input"
      },
      "value": "user@example.com"
    },
    {
      "step_id": "fill-password",
      "action": "fill",
      "locator": {
        "kind": "test_id",
        "value": "password-input"
      },
      "value": "wrong-password"
    },
    {
      "step_id": "submit",
      "action": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Log In"
      }
    }
  ]
}
