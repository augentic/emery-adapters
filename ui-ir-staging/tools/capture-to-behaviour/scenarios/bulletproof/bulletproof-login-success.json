{
  "version": 1,
  "id": "bulletproof-login-success",
  "screen": "login",
  "serve": {
    "dir": "${SITES}/bulletproof-react/apps/react-vite/dist",
    "spa_fallback": true
  },
  "network": {
    "stubs": [
      {
        "method": "GET",
        "origin": "http://127.0.0.1:8080",
        "path": "/api/auth/me",
        "status": 200,
        "body": {
          "data": null
        }
      },
      {
        "method": "POST",
        "origin": "http://127.0.0.1:8080",
        "path": "/api/auth/login",
        "status": 200,
        "body": {
          "jwt": "stub-jwt",
          "user": {
            "id": "u1",
            "email": "user@example.com",
            "firstName": "Stub",
            "lastName": "User",
            "role": "ADMIN",
            "teamId": "t1",
            "bio": "",
            "createdAt": 1767225600000
          }
        }
      }
    ]
  },
  "start_path": "/auth/login",
  "actions": [
    {
      "step_id": "fill-email",
      "action": "fill",
      "locator": {
        "kind": "css",
        "value": "input[name=email]"
      },
      "value": "user@example.com"
    },
    {
      "step_id": "fill-password",
      "action": "fill",
      "locator": {
        "kind": "css",
        "value": "input[name=password]"
      },
      "value": "password123"
    },
    {
      "step_id": "submit",
      "action": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Log in"
      }
    },
    {
      "step_id": "wait-dashboard",
      "action": "wait_for",
      "locator": {
        "kind": "role",
        "role": "heading",
        "name": "Dashboard"
      },
      "timeout_ms": 8000
    }
  ]
}
