{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-ir:core:behaviour:1",
  "title": "ui-ir behaviour layer",
  "description": "behaviour.json in an IR directory: the facts of what acting on a screen does, as the code and the recorded runs show them. Facts only: no intent prose, no names a person chose for a group, no derived state. Every entry carries evidence: a `file#L` anchor into the bound source, or an observation from a recording with its replay digest. Nodes are referenced by the composition node id (docs/node-id.md). Platform-only facts sit in `x-web` / `x-mobile` / `x-ios` / `x-android` slots, exactly as in composition.json.",
  "type": "object",
  "required": [
    "version",
    "screen",
    "routes",
    "triggers",
    "guards",
    "state",
    "validation",
    "transitions"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "screen": {
      "$ref": "#/$defs/slug"
    },
    "routes": {
      "type": "array",
      "description": "Every route the screen's code declares or navigates to, by path. Sorted by path.",
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "triggers": {
      "type": "array",
      "description": "What acting on a node does: one entry per place in the code that wires a gesture. Sorted by id.",
      "items": {
        "$ref": "#/$defs/trigger"
      }
    },
    "guards": {
      "type": "array",
      "description": "Conditions checked before a route renders, and where they send the user.",
      "items": {
        "$ref": "#/$defs/guard"
      }
    },
    "state": {
      "type": "object",
      "description": "State the screen's code declares, keyed `<file>:<component>.<name>`. Initial values are literals as written; derived state is never recorded.",
      "propertyNames": {
        "pattern": "^[^\\s:]+:[A-Za-z0-9_$.]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/stateEntry"
      }
    },
    "validation": {
      "type": "array",
      "description": "Field rules as the schema the form is bound to spells them.",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 0,
      "description": "Reserved (catalog motion.*). Always empty in version 1."
    },
    "x-web": {
      "$ref": "#/$defs/extensionSlot"
    },
    "x-mobile": {
      "$ref": "#/$defs/extensionSlot"
    },
    "x-ios": {
      "$ref": "#/$defs/extensionSlot"
    },
    "x-android": {
      "$ref": "#/$defs/extensionSlot"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/n-[0-9a-f]{16}$",
      "description": "`<screen>/n-<first 16 hex of sha256(path)>`, see docs/node-id.md."
    },
    "anchor": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[^#\\s]+#L[1-9][0-9]*(-L[1-9][0-9]*)?$",
          "description": "Relative to the bound source root; the tightest line range that spells the fact."
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "recording",
        "step",
        "replay_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "recording": {
          "type": "string",
          "minLength": 1,
          "description": "The recording's scenario id."
        },
        "step": {
          "type": "string",
          "minLength": 1,
          "description": "The step_id the observation was made at."
        },
        "replay_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "confirms": {
          "type": "array",
          "description": "Effects of `does` the run showed happening: an index, the path of an effect inside a call's on_success / on_failure (`2.on_success.0`), or `self` for a guard or rule.",
          "items": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "const": "self"
              },
              {
                "type": "string",
                "pattern": "^[0-9]+(\\.on_(success|failure)\\.[0-9]+)+$"
              }
            ]
          }
        },
        "contradicts": {
          "type": "array",
          "description": "Effects the code makes certain that the run shows did not happen (an unconditional navigate, or a branch whose call outcome was seen, with no validation message on screen).",
          "items": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "const": "self"
              },
              {
                "type": "string",
                "pattern": "^[0-9]+(\\.on_(success|failure)\\.[0-9]+)+$"
              }
            ]
          }
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]+ \\S+ ([0-9]{3}|failed|blocked)$"
          }
        },
        "unexplained": {
          "type": "array",
          "description": "Requests of the step that no `call` in `does` accounts for.",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]+ \\S+ ([0-9]{3}|failed|blocked)$"
          }
        },
        "bodies": {
          "type": "array",
          "description": "Shape of request bodies the step sent for a `call` in `does`: media type and field names, never values.",
          "items": {
            "type": "object",
            "required": [
              "request",
              "content_type",
              "fields"
            ],
            "additionalProperties": false,
            "properties": {
              "request": {
                "type": "string",
                "pattern": "^[A-Z]+ \\S+$"
              },
              "content_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fields": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "page_errors": {
          "type": "array",
          "description": "Uncaught page errors and console errors raised during the step.",
          "items": {
            "type": "string"
          }
        },
        "url_before": {
          "type": "string"
        },
        "url_after": {
          "type": "string"
        }
      }
    },
    "observed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "evidenced": {
      "anyOf": [
        {
          "required": [
            "evidence"
          ]
        },
        {
          "required": [
            "observed"
          ]
        }
      ]
    },
    "extensionSlot": {
      "type": "object"
    },
    "route": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/evidenced"
        }
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "declared": {
          "type": "boolean",
          "description": "True where the code declares the route (not only navigates to it)."
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "observed": {
          "$ref": "#/$defs/observed"
        }
      }
    },
    "match": {
      "type": "object",
      "description": "The tuple a code element is matched to DOM nodes by: role, visible text, href, form-field name, and whether it renders inside an overlay. `null` means the code does not fix that value.",
      "required": [
        "role",
        "text",
        "href",
        "name",
        "in_overlay"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "href": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "in_overlay": {
          "type": "boolean"
        },
        "text_in": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "When `text` is null because the code renders one of a few literal texts (a conditional between literals): those texts. A node fits when its text is one of them."
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "gesture",
        "match",
        "nodes",
        "match_status"
      ],
      "additionalProperties": false,
      "properties": {
        "gesture": {
          "enum": [
            "tap",
            "submit",
            "change",
            "long_press",
            "swipe"
          ]
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nodeId"
          },
          "uniqueItems": true
        },
        "match_status": {
          "enum": [
            "unresolved",
            "none",
            "unique",
            "multiple",
            "ambiguous"
          ],
          "description": "unresolved: no recording was applied yet; none: no node fits; unique: one; multiple: one definition rendered at several nodes; ambiguous: another code element has the same tuple, so no node is claimed."
        },
        "submitters": {
          "type": "array",
          "description": "On a submit: the submit controls inside the form, matched the same way.",
          "items": {
            "type": "object",
            "required": [
              "match",
              "nodes",
              "match_status"
            ],
            "additionalProperties": false,
            "properties": {
              "match": {
                "$ref": "#/$defs/match"
              },
              "nodes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/nodeId"
                },
                "uniqueItems": true
              },
              "match_status": {
                "enum": [
                  "unresolved",
                  "none",
                  "unique",
                  "multiple",
                  "ambiguous"
                ]
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              }
            }
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "required": [
        "expr"
      ],
      "additionalProperties": false,
      "properties": {
        "expr": {
          "type": "string",
          "minLength": 1,
          "description": "The condition as written in the code. Never evaluated or rewritten."
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "x-web": {
          "$ref": "#/$defs/extensionSlot"
        }
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "effect": {
      "type": "object",
      "required": [
        "kind",
        "evidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "navigate",
            "back",
            "scroll_to",
            "open_url",
            "open",
            "close",
            "toggle",
            "set",
            "call",
            "show",
            "validate"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "x-web": {
          "$ref": "#/$defs/extensionSlot"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "navigate"
              }
            }
          },
          "then": {
            "required": [
              "to"
            ],
            "properties": {
              "to": {
                "type": "string",
                "pattern": "^/"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "scroll_to"
              }
            }
          },
          "then": {
            "required": [
              "anchor"
            ],
            "properties": {
              "anchor": {
                "type": "string",
                "pattern": "^#"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "open_url"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^[a-z]+:"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "open",
                  "close",
                  "toggle"
                ]
              }
            }
          },
          "then": {
            "required": [
              "overlay"
            ],
            "properties": {
              "overlay": {
                "enum": [
                  "dialog",
                  "sheet",
                  "menu",
                  "popover",
                  "tooltip"
                ]
              },
              "state": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "set"
              }
            }
          },
          "then": {
            "required": [
              "state",
              "value"
            ],
            "properties": {
              "state": {
                "type": "string"
              },
              "value": {
                "type": [
                  "boolean",
                  "string",
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "call"
              }
            }
          },
          "then": {
            "required": [
              "callee"
            ],
            "properties": {
              "callee": {
                "type": "string",
                "pattern": "^\\S+:\\S+$"
              },
              "args": {
                "type": "array"
              },
              "operation": {
                "type": "object",
                "required": [
                  "method",
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "method": {
                    "enum": [
                      "GET",
                      "POST",
                      "PUT",
                      "PATCH",
                      "DELETE"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "evidence": {
                    "$ref": "#/$defs/evidence"
                  }
                }
              },
              "on_success": {
                "$ref": "#/$defs/effects"
              },
              "on_failure": {
                "$ref": "#/$defs/effects"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "show"
              }
            }
          },
          "then": {
            "required": [
              "surface"
            ],
            "properties": {
              "surface": {
                "enum": [
                  "toast",
                  "snackbar"
                ]
              },
              "tone": {
                "enum": [
                  "error",
                  "success",
                  "info",
                  "warning",
                  "neutral"
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "validate"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "trigger": {
      "type": "object",
      "required": [
        "id",
        "on",
        "does",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^t-[0-9a-f]{12}$"
        },
        "on": {
          "$ref": "#/$defs/target"
        },
        "guard": {
          "type": "array",
          "description": "Early exits in the handler: when the condition holds, nothing else in `does` runs.",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "does": {
          "$ref": "#/$defs/effects"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "observed": {
          "$ref": "#/$defs/observed"
        },
        "x-web": {
          "$ref": "#/$defs/extensionSlot"
        },
        "x-mobile": {
          "$ref": "#/$defs/extensionSlot"
        },
        "x-ios": {
          "$ref": "#/$defs/extensionSlot"
        },
        "x-android": {
          "$ref": "#/$defs/extensionSlot"
        }
      }
    },
    "guard": {
      "type": "object",
      "required": [
        "route",
        "when",
        "go",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "route": {
          "type": "string",
          "pattern": "^/"
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "go": {
          "type": "string",
          "pattern": "^/"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "observed": {
          "$ref": "#/$defs/observed"
        }
      }
    },
    "stateEntry": {
      "type": "object",
      "required": [
        "kind",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "flag",
            "value",
            "field"
          ]
        },
        "initial": {
          "type": [
            "boolean",
            "string",
            "number",
            "null"
          ]
        },
        "controls": {
          "type": "object",
          "required": [
            "overlay"
          ],
          "additionalProperties": false,
          "properties": {
            "overlay": {
              "enum": [
                "dialog",
                "sheet",
                "menu",
                "popover",
                "tooltip"
              ]
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "x-web": {
          "$ref": "#/$defs/extensionSlot"
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "field",
        "rule",
        "nodes",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "enum": [
            "required",
            "email",
            "min_length",
            "max_length",
            "pattern",
            "min",
            "max",
            "url"
          ]
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nodeId"
          },
          "uniqueItems": true
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "observed": {
          "$ref": "#/$defs/observed"
        }
      }
    }
  }
}
