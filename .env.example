# Required.
CURSOR_API_KEY=<your Cursor API key>
# Optional. Default model when a request leaves model unset. To list models,
# run `cursor-agent --list-models`. Blank/unset lets cursor-agent choose.
CURSOR_MODEL=<Cursor model ID>
# Optional. Per-spawn cursor-agent wall-clock timeout in seconds. The example
# tasks (`cargo make eval`, `cargo make wasm-*`) default this to 1800 via
# examples/Makefile.toml — the cursor backend's bare default of 600 kills
# review legs mid-work (RFC-78 D4.1). Override here to change that default.
CURSOR_TIMEOUT_SECS=<u64 seconds>
