# Required.
CURSOR_API_KEY=<your Cursor API key>
# Optional. Default model when a request leaves model unset. To list models,
# run `cursor-agent --list-models`. Blank/unset lets cursor-agent choose.
CURSOR_MODEL=<Cursor model ID>
# Optional. Per-spawn cursor-agent wall-clock timeout in seconds. The
# cursor backend's bare default of 600 can cut a long extraction short;
# raise it (1800 is a typical floor) before walking the live examples.
CURSOR_TIMEOUT_SECS=<u64 seconds>
