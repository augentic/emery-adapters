# The one definition of the change trial's operator inputs, shared by
# the native live trial (`cargo make eval`; eval/src/trial.rs) and the
# wasm change example (`cargo make change-run`; Makefile.toml).
#
# Shell-sourceable KEY="value" lines only — the Rust parser
# (eval/src/inputs.rs) accepts exactly this shape, so keep values free
# of shell expansion ($, backticks) and inner double quotes.

TRIAL_PROJECT_NAME="orders"
TRIAL_CHANGE="orders"
TRIAL_SOURCE="docs=documentation:docs"
TRIAL_INTENT="Author the API contracts for the orders service described under docs/: the JSON Schema vocabulary plus the HTTP (OpenAPI) surface. Contracts only - no service implementation."
