# The one definition of the change trial's operator inputs, sourced by
# both native eval and the wasm change example from Makefile.toml.
#
# Shell-sourceable KEY="value" lines only — the shared harness parser
# accepts exactly this shape, so keep values free of shell expansion
# ($, backticks) and inner double quotes.

TRIAL_PROJECT_NAME="orders"
TRIAL_CHANGE="orders"
TRIAL_SOURCE="docs=documentation:docs"
TRIAL_INTENT="Author the API contracts for the orders service described under docs/: the JSON Schema vocabulary plus the HTTP (OpenAPI) surface. Contracts only - no service implementation."
